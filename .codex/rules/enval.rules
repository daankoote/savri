# Reason: the canonical preview wrapper needs macOS process inspection to prove
# PID ownership, which is unavailable inside the workspace sandbox; its parser
# accepts exactly one operation and only the approved Beheer binding.
# MATCH: /usr/local/bin/node scripts/tools/enval-preview.mjs status Beheer
# NOT_MATCH: /usr/local/bin/node scripts/tools/enval-preview.mjs status Main
prefix_rule(
    pattern = ["/usr/local/bin/node", "scripts/tools/enval-preview.mjs", ["start", "status", "stop"], "Beheer"],
    decision = "allow",
)

# Reason: Git mutation remains human-owned and must never be auto-approved;
# the read-only .git filesystem boundary independently blocks compound bypass.
# MATCH: git add app/src/App.tsx
# NOT_MATCH: git status --short
prefix_rule(
    pattern = ["git", ["add", "am", "apply", "checkout", "cherry-pick", "clean", "commit", "merge", "mv", "push", "rebase", "reset", "restore", "revert", "rm", "stash", "switch", "worktree"]],
    decision = "forbidden",
)

# Reason: execpolicy cannot inspect SQL supplied on stdin, so direct psql cannot
# be reviewed safely; normal database reads and fixture writes use guarded wrappers.
# MATCH: psql postgresql://postgres@127.0.0.1:54322/postgres
# NOT_MATCH: node scripts/tools/enval-supabase-target.mjs --target TENANT_ENVAL --operation db-identity
prefix_rule(pattern = ["psql"], decision = "forbidden")

# Reason: a local database reset is destructive but can be explicitly reviewed.
# MATCH: supabase db reset
# NOT_MATCH: supabase status
prefix_rule(pattern = ["supabase", "db", "reset"], decision = "prompt")

# Reason: database push writes schema to a linked remote target and is not a
# normal local-development operation.
# MATCH: supabase db push
# NOT_MATCH: supabase db diff --local
prefix_rule(pattern = ["supabase", "db", "push"], decision = "forbidden")

# Reason: migration repair/up can change remote migration history or schema;
# the command prefix cannot prove a trailing local-only flag.
# MATCH: supabase migration up
# NOT_MATCH: supabase migration list
prefix_rule(pattern = ["supabase", "migration", ["repair", "up"]], decision = "forbidden")

# Reason: function delete/deploy changes a remotely visible runtime.
# MATCH: supabase functions deploy api-app-operator-context
# NOT_MATCH: supabase functions list
prefix_rule(pattern = ["supabase", "functions", ["delete", "deploy"]], decision = "forbidden")

# Reason: project link changes the target used by later Supabase commands.
# MATCH: supabase link --project-ref example
# NOT_MATCH: supabase status
prefix_rule(pattern = ["supabase", ["link", "unlink"]], decision = "prompt")

# Reason: secret set/unset changes externally consumed credentials.
# MATCH: supabase secrets set NAME=value
# NOT_MATCH: supabase secrets list
prefix_rule(pattern = ["supabase", "secrets", ["set", "unset"]], decision = "forbidden")

# Reason: deployment CLIs perform externally visible writes that loopback-only
# product development does not need.
# MATCH: vercel deploy
# NOT_MATCH: node scripts/tools/enval-local-dev.mjs --operation ready
prefix_rule(pattern = [["netlify", "vercel", "wrangler"]], decision = "forbidden")

# Compound shell commands intentionally have no allow rule. A wrapper such as
# /bin/zsh -lc "git status && git add ." is no_match, and the read-only .git
# filesystem boundary still blocks the nested mutation.
