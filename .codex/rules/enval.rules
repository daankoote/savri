prefix_rule(pattern = ["git", "status"], decision = "allow")

# Deterministic read-only Git evidence. `git branch` stays prompt-gated because
# prefix matching cannot exclude trailing mutation flags.
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "show"], decision = "allow")
prefix_rule(pattern = ["git", "rev-parse"], decision = "allow")
prefix_rule(pattern = ["git", "branch"], decision = "prompt")

# Exact read-only Git evidence transported by Codex Desktop. The complete inner
# script is one literal argv token; altered, compound, and login-shell forms do
# not match these lanes.
prefix_rule(
    pattern = ["/bin/zsh", "-c", "git rev-parse HEAD"],
    decision = "allow",
    justification = "Exact read-only HEAD evidence via Codex Desktop transport",
    match = [["/bin/zsh", "-c", "git rev-parse HEAD"]],
    not_match = [
        ["/bin/zsh", "-c", "git add ."],
        ["/bin/zsh", "-c", "git rev-parse HEAD; git add ."],
        ["/bin/zsh", "-c", "git rev-parse HEAD && git add ."],
        ["/bin/zsh", "-lc", "git rev-parse HEAD"],
    ],
)
prefix_rule(
    pattern = ["/bin/zsh", "-c", "git status --short"],
    decision = "allow",
    justification = "Exact read-only worktree evidence via Codex Desktop transport",
    match = [["/bin/zsh", "-c", "git status --short"]],
    not_match = [
        ["/bin/zsh", "-c", "git status --porcelain"],
        ["/bin/zsh", "-c", "git status --short; git add ."],
        ["/bin/zsh", "-c", "git status --short && git add ."],
        ["/bin/zsh", "-lc", "git status --short"],
    ],
)
prefix_rule(
    pattern = ["/bin/zsh", "-c", "git branch --show-current"],
    decision = "allow",
    justification = "Exact read-only branch evidence via Codex Desktop transport",
    match = [["/bin/zsh", "-c", "git branch --show-current"]],
    not_match = [
        ["/bin/zsh", "-c", "git branch --list"],
        ["/bin/zsh", "-c", "git branch --show-current; git add ."],
        ["/bin/zsh", "-c", "git branch --show-current && git add ."],
        ["/bin/zsh", "-lc", "git branch --show-current"],
    ],
)

# Git history, index, branch, and worktree mutations remain human-controlled.
prefix_rule(pattern = ["git", "add"], decision = "forbidden")
prefix_rule(pattern = ["git", "commit"], decision = "forbidden")
prefix_rule(pattern = ["git", "push"], decision = "forbidden")
prefix_rule(pattern = ["git", "merge"], decision = "forbidden")
prefix_rule(pattern = ["git", "rebase"], decision = "forbidden")
prefix_rule(pattern = ["git", "reset"], decision = "forbidden")
prefix_rule(pattern = ["git", "restore"], decision = "forbidden")
prefix_rule(pattern = ["git", "checkout"], decision = "forbidden")
prefix_rule(pattern = ["git", "switch"], decision = "forbidden")
prefix_rule(pattern = ["git", "worktree"], decision = "forbidden")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden")
prefix_rule(pattern = ["git", "stash"], decision = "forbidden")
prefix_rule(pattern = ["git", "cherry-pick"], decision = "forbidden")
prefix_rule(pattern = ["git", "revert"], decision = "forbidden")
prefix_rule(pattern = ["git", "rm"], decision = "forbidden")
prefix_rule(pattern = ["git", "mv"], decision = "forbidden")
prefix_rule(pattern = ["git", "apply"], decision = "forbidden")
prefix_rule(pattern = ["git", "am"], decision = "forbidden")

# The verifier accepts repeated mode flags and higher modes can execute bounded
# local writes. Prefix matching cannot safely auto-allow only pure modes.
prefix_rule(pattern = ["node", "scripts/tools/enval-verify.mjs"], decision = "prompt")
prefix_rule(pattern = ["node", "scripts/tools/enval-verify.mjs", "--mode", "RELEASE"], decision = "forbidden")

# Self-cleaning behavioral proof for the verifier and its guarded wrappers.
prefix_rule(pattern = ["node", "scripts/proofs/enval-verify-runner.proof.mjs"], decision = "allow")

# Hash-pinned, loopback-only, transaction-read-only SQL proof wrapper.
prefix_rule(pattern = ["node", "scripts/tools/enval-readonly-sql.mjs", "--proof-id", "enval-local-readonly-catalog"], decision = "allow")

# Guarded local runtime operations. The wrapper accepts loopback Vite URLs only.
prefix_rule(pattern = ["node", "scripts/tools/enval-local-dev.mjs", "--operation", "ready"], decision = "allow")
prefix_rule(pattern = ["node", "scripts/tools/enval-local-dev.mjs", "--operation", "serve"], decision = "allow")

# Target inspection remains prompt-gated because repeated selector flags can
# override an earlier prefix match; exact end-of-command matching is required.
prefix_rule(pattern = ["node", "scripts/tools/enval-supabase-target.mjs"], decision = "prompt")
prefix_rule(pattern = ["node", "scripts/tools/enval-supabase-target.mjs", "--target", "CONTROL_PLANE", "--operation", "start"], decision = "forbidden")
prefix_rule(pattern = ["node", "scripts/tools/enval-supabase-target.mjs", "--target", "CONTROL_PLANE", "--operation", "stop"], decision = "forbidden")
prefix_rule(pattern = ["node", "scripts/tools/enval-supabase-target.mjs", "--target", "CONTROL_PLANE", "--operation", "db-reset"], decision = "forbidden")
prefix_rule(pattern = ["node", "scripts/tools/enval-supabase-target.mjs", "--target", "TENANT_ENVAL", "--operation", "start"], decision = "forbidden")
prefix_rule(pattern = ["node", "scripts/tools/enval-supabase-target.mjs", "--target", "TENANT_ENVAL", "--operation", "stop"], decision = "forbidden")
prefix_rule(pattern = ["node", "scripts/tools/enval-supabase-target.mjs", "--target", "TENANT_ENVAL", "--operation", "db-reset"], decision = "forbidden")

# Docker inspection is narrow; container and infrastructure mutations stay denied.
prefix_rule(pattern = ["docker", "ps"], decision = "allow")
prefix_rule(pattern = ["docker", "exec"], decision = "forbidden")
prefix_rule(pattern = ["docker", "compose"], decision = "forbidden")
prefix_rule(pattern = ["docker", "rm"], decision = "forbidden")
prefix_rule(pattern = ["docker", "rmi"], decision = "forbidden")
prefix_rule(pattern = ["docker", "stop"], decision = "forbidden")
prefix_rule(pattern = ["docker", "kill"], decision = "forbidden")
prefix_rule(pattern = ["docker", "volume"], decision = "forbidden")
prefix_rule(pattern = ["docker", "network"], decision = "forbidden")
prefix_rule(pattern = ["docker", "system"], decision = "forbidden")

# Shell evaluators and environment wrappers other than the exact Desktop lanes
# above remain gated so wrapper approvals cannot bypass the direct command policy.
prefix_rule(pattern = ["zsh"], decision = "prompt")
prefix_rule(pattern = ["/bin/bash"], decision = "prompt")
prefix_rule(pattern = ["bash"], decision = "prompt")
prefix_rule(pattern = ["/bin/sh"], decision = "prompt")
prefix_rule(pattern = ["sh"], decision = "prompt")
prefix_rule(pattern = ["env"], decision = "prompt")

# Generic database/provider CLIs, dependency changes, deployment tools, elevated
# system commands, and arbitrary network clients remain gated or forbidden.
prefix_rule(pattern = ["psql"], decision = "forbidden")
prefix_rule(pattern = ["supabase"], decision = "prompt")
prefix_rule(pattern = ["supabase", "db", "reset"], decision = "forbidden")
prefix_rule(pattern = ["supabase", "db", "push"], decision = "forbidden")
prefix_rule(pattern = ["supabase", "migration", "up"], decision = "forbidden")
prefix_rule(pattern = ["supabase", "functions", "deploy"], decision = "forbidden")
prefix_rule(pattern = ["supabase", "link"], decision = "forbidden")
prefix_rule(pattern = ["npm"], decision = "prompt")
prefix_rule(pattern = ["npm", "install"], decision = "forbidden")
prefix_rule(pattern = ["npm", "i"], decision = "forbidden")
prefix_rule(pattern = ["npm", "ci"], decision = "forbidden")
prefix_rule(pattern = ["npm", "update"], decision = "forbidden")
prefix_rule(pattern = ["npm", "uninstall"], decision = "forbidden")
prefix_rule(pattern = ["npm", "remove"], decision = "forbidden")
prefix_rule(pattern = ["npx"], decision = "forbidden")
prefix_rule(pattern = ["deno"], decision = "prompt")
prefix_rule(pattern = ["deno", "add"], decision = "forbidden")
prefix_rule(pattern = ["deno", "install"], decision = "forbidden")
prefix_rule(pattern = ["deno", "uninstall"], decision = "forbidden")
prefix_rule(pattern = ["deno", "remove"], decision = "forbidden")
prefix_rule(pattern = ["deno", "cache"], decision = "forbidden")
prefix_rule(pattern = ["deno", "upgrade"], decision = "forbidden")
prefix_rule(pattern = ["sudo"], decision = "forbidden")
prefix_rule(pattern = ["netlify"], decision = "prompt")
prefix_rule(pattern = ["vercel"], decision = "prompt")
prefix_rule(pattern = ["wrangler"], decision = "prompt")
prefix_rule(pattern = ["curl"], decision = "prompt")
prefix_rule(pattern = ["wget"], decision = "prompt")
prefix_rule(pattern = ["ssh"], decision = "prompt")
prefix_rule(pattern = ["scp"], decision = "prompt")
