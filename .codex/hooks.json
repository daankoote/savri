{
  "description": "ENVAL deterministic Bash permission routing.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/enval-permission-router.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking ENVAL human gates"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/enval-permission-router.mjs\"",
            "timeout": 5,
            "statusMessage": "Routing ENVAL approval request"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/enval-permission-router.mjs\"",
            "timeout": 5,
            "statusMessage": "Opening ENVAL workspace result run"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/enval-permission-router.mjs\"",
            "timeout": 5,
            "statusMessage": "Publishing ENVAL result"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/enval-permission-router.mjs\"",
            "timeout": 5,
            "statusMessage": "Publishing interrupted ENVAL result"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/enval-permission-router.mjs\"",
            "timeout": 5,
            "statusMessage": "Finalizing ENVAL session result"
          }
        ]
      }
    ]
  }
}
