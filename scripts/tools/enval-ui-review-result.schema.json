{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdict",
    "reviewNumber",
    "reviewContextId",
    "independentContext",
    "reviewOnlyAuthority",
    "findings",
    "unreviewed",
    "productCodeModified",
    "humanFinalAcceptanceRequired"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "reviewNumber": { "type": "integer", "minimum": 1, "maximum": 6 },
    "reviewContextId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "independentContext": { "const": true },
    "reviewOnlyAuthority": { "const": true },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "route",
          "state",
          "viewport",
          "evidenceReference",
          "text"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^UIR-[0-9]{3,}$" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "route": { "type": "string", "minLength": 1, "maxLength": 500 },
          "state": { "type": "string", "minLength": 1, "maxLength": 500 },
          "viewport": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidenceReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "unreviewed": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "productCodeModified": { "const": false },
    "humanFinalAcceptanceRequired": { "const": true }
  }
}
